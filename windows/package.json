{
  "name": "webforge",
  "productName": "WebForge",
  "description": "WebForge browser \u2014 Windows shell",
  "version": "0.1.40",
  "main": "main.js",
  "author": "Brandon Bell",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.1",
    "@mozilla/readability": "^0.6.0",
    "@xterm/addon-fit": "0.12.0-beta.301",
    "@xterm/addon-web-links": "0.13.0-beta.301",
    "@xterm/addon-webgl": "0.20.0-beta.300",
    "@xterm/xterm": "6.1.0-beta.304",
    "electron-updater": "^6.3.9",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.webforge.browser",
    "productName": "WebForge",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.js",
      "!*.test.js",
      "ui/**",
      {
        "from": "../shared",
        "to": "shared"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "generic",
      "url": "http://100.69.184.113:8012/windows"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "WebForge-${version}-${arch}.${ext}",
      "publish": {
        "provider": "generic",
        "url": "http://100.69.184.113:8012/mac"
      }
    }
  }
}
