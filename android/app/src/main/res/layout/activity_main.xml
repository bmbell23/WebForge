<?xml version="1.0" encoding="utf-8"?>
<!-- #58: bar at the TOP, with the Android status bar still showing above it.
     statusSpacer is padded at runtime to the status-bar + camera-cutout inset
     and lives INSIDE the bar container, so that strip renders in the same
     colour as the address bar — one solid block from the screen edge down. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBarWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0A0A0C">

            <!-- height set from the real window insets at runtime -->
            <View
                android:id="@+id/statusSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp">

                <!-- #87: tabs LEFT, bookmarks RIGHT, address between —
                     mirroring the two Windows sidebars. -->
                <TextView
                    android:id="@+id/tabsBtn"
                    android:layout_width="40dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#E8E8EA"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/tabcount_bg" />

                <EditText
                    android:id="@+id/urlBar"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/urlbar_bg"
                    android:hint="Search or enter address"
                    android:textColorHint="#7C7C82"
                    android:textColor="#E8E8EA"
                    android:textSize="14sp"
                    android:paddingHorizontal="14dp"
                    android:inputType="textUri"
                    android:imeOptions="actionGo"
                    android:maxLines="1"
                    android:selectAllOnFocus="true"
                    android:importantForAutofill="no" />

                <TextView
                    android:id="@+id/bookmarksBtn"
                    android:layout_width="42dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:text="📚"
                    android:textColor="#E8E8EA"
                    android:textSize="17sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="100"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Overlay host for the tab sheet, menu, bookmarks and settings. -->
    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>
